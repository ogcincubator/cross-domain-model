# SHACL shapes for the W3C PROV-O ontology (http://www.w3.org/ns/prov#),
# mechanically derived from PROV-O's OWL axioms (rdfs:domain / rdfs:range
# per property, propagated down rdfs:subClassOf hierarchies for datatype
# properties).
#
# Generated by generate-shapes.py in this directory -- see that script's
# module docstring for the full rationale, the owl2shacl rule categories it
# follows, and -- importantly -- why object-property shapes below use a
# standalone sh:target (SPARQLTarget) rather than the sh:targetClass +
# sh:property structure still used for datatype properties. Do not hand-edit
# below this header; re-run the script instead.
#
# NOT covered here (left to the curated CDO-Shapes-PROV-O library,
# https://github.com/Cyber-Domain-Ontology/CDO-Shapes-PROV-O, not currently
# declared in bblock.json's shaclShapes):
#   - the 4 owl:disjointWith class-pairs
#   - the 1 owl:Restriction (ActivityInfluence: maxCardinality 0 on
#     prov:hadActivity)
#
# A blank-node object-property value is only sh:class-checked when it actually
# carries an rdf:type -- a blank node with any other content, using any predicates,
# is never *required* to be typed, exactly like a plain IRI value (a by-reference
# pointer to an object described elsewhere, per PROV-O's own open-world semantics).
# If a type IS given, it must be one of the property's range classes. See the script
# docstring for the two pySHACL evaluation quirks that make a standalone sh:target
# plus a direct (non-sh:or) sh:sparql constraint the only reliable way to express
# this.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@base <https://www.ogc.org/rules/prov/> .

<#Activity-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:property <#prop-endedAtTime> , <#prop-startedAtTime> .

<#Bundle-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Bundle ;
    sh:property <#prop-generatedAtTime> , <#prop-invalidatedAtTime> , <#prop-value> .

<#Collection-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Collection ;
    sh:property <#prop-generatedAtTime> , <#prop-invalidatedAtTime> , <#prop-value> .

<#EmptyCollection-shape>
    a sh:NodeShape ;
    sh:targetClass prov:EmptyCollection ;
    sh:property <#prop-generatedAtTime> , <#prop-invalidatedAtTime> , <#prop-value> .

<#End-shape>
    a sh:NodeShape ;
    sh:targetClass prov:End ;
    sh:property <#prop-atTime> .

<#Entity-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Entity ;
    sh:property <#prop-generatedAtTime> , <#prop-invalidatedAtTime> , <#prop-value> .

<#Generation-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Generation ;
    sh:property <#prop-atTime> .

<#InstantaneousEvent-shape>
    a sh:NodeShape ;
    sh:targetClass prov:InstantaneousEvent ;
    sh:property <#prop-atTime> .

<#Invalidation-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Invalidation ;
    sh:property <#prop-atTime> .

<#Plan-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Plan ;
    sh:property <#prop-generatedAtTime> , <#prop-invalidatedAtTime> , <#prop-value> .

<#Start-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Start ;
    sh:property <#prop-atTime> .

<#Usage-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Usage ;
    sh:property <#prop-atTime> .

<#prop-atTime>
    a sh:PropertyShape ;
    sh:path prov:atTime ;
    rdfs:isDefinedBy prov:atTime ;
    sh:datatype xsd:dateTime .

<#prop-endedAtTime>
    a sh:PropertyShape ;
    sh:path prov:endedAtTime ;
    rdfs:isDefinedBy prov:endedAtTime ;
    sh:datatype xsd:dateTime .

<#prop-generatedAtTime>
    a sh:PropertyShape ;
    sh:path prov:generatedAtTime ;
    rdfs:isDefinedBy prov:generatedAtTime ;
    sh:datatype xsd:dateTime .

<#prop-invalidatedAtTime>
    a sh:PropertyShape ;
    sh:path prov:invalidatedAtTime ;
    rdfs:isDefinedBy prov:invalidatedAtTime ;
    sh:datatype xsd:dateTime .

<#prop-startedAtTime>
    a sh:PropertyShape ;
    sh:path prov:startedAtTime ;
    rdfs:isDefinedBy prov:startedAtTime ;
    sh:datatype xsd:dateTime .

<#prop-value>
    a sh:PropertyShape ;
    sh:path prov:value ;
    rdfs:isDefinedBy prov:value .

<#prop-actedOnBehalfOf>
    a sh:NodeShape ;
    rdfs:isDefinedBy prov:actedOnBehalfOf ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT ?this
            WHERE {
                ?s prov:actedOnBehalfOf ?this .
                { ?s rdf:type/rdfs:subClassOf* prov:Agent }
                FILTER isBlank(?this)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When typed, prov:actedOnBehalfOf's value must be one of: prov:Agent." ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this
            WHERE {
                FILTER EXISTS { $this rdf:type ?bblocksType }
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* prov:Agent }
            }
        """ ;
    ] .

