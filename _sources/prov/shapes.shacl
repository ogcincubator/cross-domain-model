<#prop-wasInfluencedBy>
    a sh:NodeShape ;
    rdfs:isDefinedBy prov:wasInfluencedBy ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT ?this
            WHERE {
                ?s prov:wasInfluencedBy ?this .
                { { ?s rdf:type/rdfs:subClassOf* prov:Activity } UNION { ?s rdf:type/rdfs:subClassOf* prov:Agent } UNION { ?s rdf:type/rdfs:subClassOf* prov:Entity } }
                FILTER isBlank(?this)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When typed, prov:wasInfluencedBy's value must be one of: prov:Activity, prov:Agent, prov:Entity." ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this
            WHERE {
                FILTER EXISTS { $this rdf:type ?bblocksType }
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* prov:Activity }
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* prov:Agent }
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* prov:Entity }
            }
        """ ;
    ] .

