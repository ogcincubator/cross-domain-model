# SHACL shapes for the W3C PROV-O ontology (http://www.w3.org/ns/prov#),
# mechanically derived from PROV-O's OWL axioms (rdfs:domain / rdfs:range
# per property, propagated down rdfs:subClassOf hierarchies).
#
# Generated by generate-shapes.py in this directory -- see that script's
# module docstring for the full rationale and the owl2shacl rule categories
# it follows. Do not hand-edit below this header; re-run the script instead.
#
# NOT covered here (left to the curated shapes this block already
# references via bblock.json's shaclShapes -> CDO-Shapes-PROV-O,
# https://github.com/Cyber-Domain-Ontology/CDO-Shapes-PROV-O):
#   - the 4 owl:disjointWith class-pairs
#   - the 1 owl:Restriction (ActivityInfluence: maxCardinality 0 on
#     prov:hadActivity)

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@base <https://www.ogc.org/rules/prov/> .

<#Activity-shape>
    a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:property <#prop-atLocation> , <#prop-endedAtTime> , <#prop-generated> , <#prop-invalidated> , <#prop-qualifiedAssociation> , <#prop-qualifiedCommunication> , <#prop-qualifiedEnd> , <#prop-qualifiedInfluence> , <#prop-qualifiedStart> , <#prop-qualifiedUsage> , <#prop-startedAtTime> , <#prop-used> , <#prop-wasAssociatedWith> , <#prop-wasEndedBy> , <#prop-wasInfluencedBy> , <#prop-wasInformedBy> , <#prop-wasStartedBy> .

<#ActivityInfluence-shape>
    a sh:NodeShape ;
    sh:targetClass prov:ActivityInfluence ;
    sh:property <#prop-activity> , <#prop-hadActivity> , <#prop-hadRole> , <#prop-influencer> .

