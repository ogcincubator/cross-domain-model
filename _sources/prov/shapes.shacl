<#prop-atLocation>
    a sh:NodeShape ;
    rdfs:isDefinedBy prov:atLocation ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT ?this
            WHERE {
                ?s prov:atLocation ?this .
                { { ?s rdf:type/rdfs:subClassOf* prov:Activity } UNION { ?s rdf:type/rdfs:subClassOf* prov:Agent } UNION { ?s rdf:type/rdfs:subClassOf* prov:Entity } UNION { ?s rdf:type/rdfs:subClassOf* prov:InstantaneousEvent } }
                FILTER isBlank(?this)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When typed, prov:atLocation's value must be one of: prov:Location." ;
        sh:select """
            PREFIX prov: <http://www.w3.org/ns/prov#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this
            WHERE {
                FILTER EXISTS { $this rdf:type ?bblocksType }
                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* prov:Location }
            }
        """ ;
    ] .

